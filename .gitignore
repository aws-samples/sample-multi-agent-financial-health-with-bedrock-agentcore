# ============================================
# Root .gitignore
# ============================================

# === OS ===
.DS_Store
Thumbs.db

# === IDEs ===
.vscode/
.idea/
*.swp
*.swo

# === Python ===
__pycache__/
*.py[cod]
*.so
*.egg-info/
venv/
.venv/

# === Node.js ===
node_modules/

# === Archivos temporales / screenshots sueltos en raíz ===
/*.png
/*.jpg
/*.pdf
/*.excalidraw

# === Generated diagrams (regenerables con scripts) ===
generated-diagrams/*.png

# === CDK outputs (contienen IDs de recursos) ===
cdk-outputs*.json

# === Frontend env files (generated by deploy.sh) ===
frontend/.env

# === AgentCore dependencies (generados, ~70MB cada uno) ===
backend/.bedrock_agentcore/*/dependencies.zip
backend/.bedrock_agentcore/*/dependencies.hash
backend/.bedrock_agentcore.yaml.bak

# === CDK output ===
cdk.out/
.cdk.staging/

# === Kiro hooks (locales) ===
.kiro/hooks/gitlab-ssh-connect.kiro.hook
.kiro/hooks/auto-commit-note.kiro.hook

# === Auditorías (locales) ===
AUDITORIA-*.md
PLAN-CORRECCION-*.md
.DS_Store
.vscode/
FinancialHealth_asistente_financiero_AI.json
*.log
.playwright-mcp/

# === Reportes de escaneo de seguridad (artefactos locales de Holmes) ===
holmes-sec-report/

# === Fuentes de diagramas de trabajo (locales) ===
# Los diagramas publicables viven en diagrams/ (fuentes editables + un render
# canonico por diagrama). docs/ queda como area de trabajo local: backups .bkp
# de drawio, exports redundantes (-background, -transparent) y HTML suelto.
docs/
