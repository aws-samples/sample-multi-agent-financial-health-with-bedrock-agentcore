        <mxCell id="s10-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Consultas y gestion&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;History, LastAnalysis y UserDocuments atienden lecturas; DeleteDocument elimina PDFs y datos.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s10-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

