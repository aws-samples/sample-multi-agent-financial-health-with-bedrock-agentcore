        <mxCell id="s1-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Entrega del frontend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront sirve la SPA estatica alojada en S3 (acceso via OAC).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s1-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s2-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="115" as="geometry" /></mxCell>
        <mxCell id="s2-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="s2-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s2-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Autenticacion&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Cognito valida al usuario y emite el JWT que autoriza la API.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s2-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s3-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="230" as="geometry" /></mxCell>
        <mxCell id="s3-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="s3-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s3-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Peticiones a la API&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;El navegador llama a API Gateway con el JWT (Cognito Authorizer).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s3-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s4-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="345" as="geometry" /></mxCell>
        <mxCell id="s4-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="s4-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s4-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Subida de PDFs&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;PresignedURL genera la URL, valida duplicados por hash y el navegador sube el PDF a S3.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s4-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s5-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="460" as="geometry" /></mxCell>
        <mxCell id="s5-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="s5-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s5-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Analisis asincrono&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Dispatcher crea el job en DynamoDB y dispara al Worker de forma asincrona.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s5-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s6-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="575" as="geometry" /></mxCell>
        <mxCell id="s6-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="s6-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s6-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Invocacion del agente&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Worker invoca el AgentCore Runtime (microVM serverless).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s6-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s7-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="690" as="geometry" /></mxCell>
        <mxCell id="s7-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="s7-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s7-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Razonamiento multi-agente&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;El orquestador coordina extractor, analista, detective y simulador; usa Bedrock (Sonnet/Haiku), Memory y lee las tarjetas en DynamoDB.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s7-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="s8-grp" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="100" width="600" x="0" y="805" as="geometry" /></mxCell>
        <mxCell id="s8-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="s8-grp"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="s8-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Persistencia&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Worker guarda estado y resultado en Jobs, y los KPIs en FinancialHistory.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s8-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

