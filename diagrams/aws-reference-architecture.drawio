        <mxCell id="s11-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Analitica&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ExportDataLake vuelca DynamoDB a S3 en formato Parquet particionado.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="s11-grp"><mxGeometry height="90" width="548" x="52" as="geometry" /></mxCell>

